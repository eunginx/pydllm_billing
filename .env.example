# MariaDB root password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# Frappe admin password for the site
ADMIN_PASSWORD=change-me-to-a-strong-password

# Site domain used by Frappe and nginx
FRAPPE_SITE_NAME_HEADER=ledger.pn.sorsiri.in

# Host port exposed by the internal nginx container. Change this if it
# conflicts with another service on the production host.
NGINX_HOST_PORT=8484
