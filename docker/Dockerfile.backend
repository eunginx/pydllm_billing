# Backend Dockerfile for GitOps/Portainer deployment
# Builds a custom Frappe bench image with HRMS pre-installed
# The init.sh runs at container startup to create site if needed

FROM frappe/bench:latest

# Install additional system dependencies if needed
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy init script into image (runs at container startup via compose command)
COPY docker/init.sh /usr/local/bin/init.sh
RUN chmod +x /usr/local/bin/init.sh

# Create bench directory structure, owned by the frappe user.
RUN mkdir -p /home/frappe/frappe-bench \
    && chown -R frappe:frappe /home/frappe

# bench and its Python modules are installed in the frappe user's
# environment (pyenv + ~/.local). Running as root breaks `bench` with
# "ModuleNotFoundError: No module named 'bench'", so switch back to frappe.
USER frappe

WORKDIR /home/frappe

# The actual bench initialization happens at runtime via init.sh
# This allows the same image to work for fresh installs and existing sites
CMD ["bash", "/usr/local/bin/init.sh"]